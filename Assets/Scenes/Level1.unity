  m_Script: {fileID: 11500000, guid: 97ec1f5805c997441bf9d910dddb33eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  mensajeIntro: "\"The world as we knew it has fallen. The streets are crawling with
    the undead, and we are the only ones left standing.\n\nYour mission is critical:
    scour the map to locate the 3 lost robots. These synthetics\u2014disguised in
    alien forms\u2014protect the vital seeds and DNA required to rebuild human life.\n\nFind
    them, secure them, and escort them to the Safe Zone in the shortest time possible.
    The future of humanity rests in your hands.\""
